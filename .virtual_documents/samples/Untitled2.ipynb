import sys

sys.argv = ['', '-e','ishiki-walking-rand','--ckpt','1000','--steps','10000']

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-e", "--exp_name", type=str, default="kawada-walking")
    parser.add_argument("--ckpt", type=int, default=100)
    parser.add_argument("--steps", type=int, default=10, help="収集ステップ数")
    parser.add_argument("--out_dir", type=str, default="standup_plots", help="出力ディレクトリ")
    args = parser.parse_args()

    gs.init()

    log_dir = f"logs/{args.exp_name}"
    env_cfg, obs_cfg, reward_cfg, command_cfg, train_cfg = pickle.load(open(f"logs/{args.exp_name}/cfgs.pkl", "rb"))
    reward_cfg["reward_s"] = {}

    ## override
    # env_cfg["episode_length_s"] = 40.0
    # command_cfg["lin_vel_x_range"] = [1.0, 1.0]
    env_cfg["kd"] = 5.0
    env_cfg["termination_if_roll_greater_than"] = 100.0
    env_cfg["termination_if_pitch_greater_than"] = 100.0
    env_cfg["base_init_pos"] = [0.0, 0.0, 0.64] # 高さに変更 64

    # 上書きする関節角（joint_names の順、単位: rad）
    default_joint_angle = [
        0.0, 0.0, -0.8, 1.6, -0.8, 0.0,   # R_HIP_Y, R_HIP_R, R_HIP_P, R_KNEE, R_ANKLE_P, R_ANKLE_R
        0.0, 0.0, -0.8, 1.6, -0.8, 00,   # L_HIP_Y, L_HIP_R, L_HIP_P, L_KNEE, L_ANKLE_P, L_ANKLE_R
    ]
    assert len(default_joint_angle) == len(env_cfg["joint_names"]), "サイズ不一致"

    # 関節名→角度 の辞書へ変換して設定（環境が参照するキーは default_joint_angles）
    env_cfg["default_joint_angles"] = {
        name: ang for name, ang in zip(env_cfg["joint_names"], default_joint_angle)
    }

    # 確認用ログ
    print("Override default_joint_angles:")
    for k, v in env_cfg["default_joint_angles"].items():
        print(f"  {k}: {v:.3f}")

    env = RL_Env(
        num_envs=1,
        env_cfg=env_cfg,
        obs_cfg=obs_cfg,
        reward_cfg=reward_cfg,
        command_cfg=command_cfg,
        dt=env_cfg['dt'],
        substeps=env_cfg['substeps'],
        show_viewer=True,
    )

    runner = OnPolicyRunner(env, train_cfg, log_dir, device='cuda')
    resume_path = os.path.join(log_dir, f"model_{args.ckpt}.pt")
    runner.load(resume_path)
    policy = runner.get_inference_policy(device='cuda')

    return env, policy, args



env, policy, args = main()


