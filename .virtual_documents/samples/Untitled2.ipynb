def _to_numpy(x):
    import torch
    return x.detach().cpu().numpy().ravel() if isinstance(x, torch.Tensor) else np.asarray(x, dtype=np.float32).ravel()

def plot_torques(control_hist, external_hist, joint_names, out_dir="standup_plots"):
    """制御トルクと外力の履歴を3x4グリッドで可視化"""
    if not control_hist or not external_hist:
        print("No torque data to plot.")
        return
    os.makedirs(out_dir, exist_ok=True)

    control = np.asarray(control_hist, dtype=np.float32)  # [T, DoF]
    external = np.asarray(external_hist, dtype=np.float32)
    T, dof = control.shape
    rows = ceil(dof / 4)
    cols = 4

    fig, axes = plt.subplots(rows, cols, figsize=(cols*4.0, rows*3.0))
    axes = np.atleast_1d(axes).ravel()
    steps = np.arange(T)

    for i in range(dof):
        ax = axes[i]
        ax.plot(steps, control[:, i], label="Control torque", color="#1f77b4", lw=1.5)
        ax.plot(steps, external[:, i], label="External force", color="#d62728", lw=1.2, alpha=0.85)
        name = joint_names[i] if i < len(joint_names) else f"Joint {i}"
        ax.set_title(name, fontsize=10, fontweight="bold")
        ax.set_xlabel("Step")
        ax.set_ylabel("Torque [Nm]")
        ax.grid(True, alpha=0.3)
        if i == 0:
            ax.legend(fontsize=8)
    for j in range(dof, rows*cols):
        fig.delaxes(axes[j])

    plt.suptitle("Joint Torques (Control vs External)", fontsize=14, fontweight="bold")
    plt.tight_layout()
    out_png = os.path.join(out_dir, "torques.png")
    plt.savefig(out_png, dpi=160, bbox_inches="tight")
    plt.close(fig)  # 表示せず閉じる
    print(f"✓ Saved: {out_png}")

def eval_policy_collect_and_save(env, policy, steps=10, out_dir="standup_plots"):
    cnt = 0
    obs, _ = env.reset()

    # 履歴バッファ
    step_hist = []
    control_hist = []
    external_hist = []

    motors_dof_idx =12
    # env.robot.set_dofs_force_range([-10]*len(env.joint_names), [10]*len(env.joint_names), motors_dof_idx) #リミット設定
    env.robot.set_dofs_force_range([-10]*len(env.motors_dof_idx), [10]*len(env.motors_dof_idx), env.motors_dof_idx) #リミット設定

    idx = getattr(env, "s_dof_idmotorx", None)
    with torch.no_grad():
        for i in range(steps):
            actions = policy(obs)
            actions = actions * 0.0  # 立ち止まらせる（必要に応じて外す）
            obs, rews, dones, infos = env.step(actions)

            # 各関節の制御トルク / 外力（フォールバック付き）
            control_t = env.robot.get_dofs_control_force(idx) if idx is not None else env.robot.get_dofs_control_force()
            external_f = env.robot.get_dofs_force(idx) if idx is not None else env.robot.get_dofs_force()
            control_np = _to_numpy(control_t)
            external_np = _to_numpy(external_f)

            step_hist.append(cnt)
            control_hist.append(control_np)
            external_hist.append(external_np)

            print("Step {}: control torques: {}, external forces: {}".format(cnt, control_np, external_np))
            print("dofs_pos:",env.robot.get_dofs_position(idx))
            print("taerget_pos:",env.target_dof_pos)
            input()  # 一時停止して確認

            if i % 20 == 0:
                print(f"Step {cnt}: logged torques")
            cnt += 1

            if dones.any():
                obs, _ = env.reset()

    # 保存のみ
    plot_torques(control_hist, external_hist, env.env_cfg["joint_names"], out_dir=out_dir)

